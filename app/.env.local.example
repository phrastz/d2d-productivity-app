# Copy this file to .env.local and fill in real values.
# See ENV_SETUP.md for details on where to find each value.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Marketing Hub sync (POST /api/sync/from-hub)
# Shared secret the Hub must send as the `x-sync-secret` header.
SYNC_SECRET=your-shared-sync-secret-here
# Owner (auth.users id) that newly created hub-synced projects/tasks are
# attributed to, since owner_id is required but the Hub has no D2D user context.
SYNC_DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000000
